#!/bin/sh
# viewer-open [file]   show a picture, PDF, video or audio file in the viewer; with no file, just the viewer.
#
# One viewer, one window: tacit-app starts it if it is not up (the probe, the single-launch lock and the
# failure notice are its), the file is handed over IPC, the window is raised.
T="${TACIT_BIN:-$HOME/.local/bin}/tacit-app"   # Tacit's launchers (the package sets TACIT_BIN)
f=""
# the launcher runs it with no file (Exec=viewer-open %f): that opens the viewer on "Nothing to show", where it used
# to fail on realpath and nothing came up at all
if [ -n "$1" ]; then
    f=$(realpath -- "$1" 2>/dev/null) || exit 1
fi
VIEWER_OPEN="$f" "$T" ensure viewer >/dev/null || exit 1
[ -n "$f" ] && "$T" call viewer open "$f" >/dev/null 2>&1
"$T" call viewer present >/dev/null 2>&1   # a closed window only hides
"$T" focus viewer
exit 0
