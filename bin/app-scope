#!/bin/sh
# app-scope <id> <command...>
#
# Start an app in its own systemd scope under app-graphical.slice, the way GNOME and KDE
# start apps. The kernel and systemd-oomd then see apps one by one: memory pressure is
# taken from, or an app is stopped, instead of the whole desktop, and focus-priority can
# favour the app in front. Without a user manager the app starts plainly.
id=$(printf '%s' "${1##*/}" | tr -c 'A-Za-z0-9_.' '_' | cut -c1-48)
shift
# The app's output goes to the journal, never to whatever started the shell: an app that inherited a terminal kept
# writing to it after the terminal closed, and Discord quit on the error ("write EIO", Discord 2026-10-29, FlorpiC). Its
# input is nothing, for the same reason.
if command -v systemd-cat >/dev/null 2>&1; then
    set -- systemd-cat --identifier="${id:-app}" -- "$@"
else
    set -- sh -c 'exec "$@" >/dev/null 2>&1' sh "$@"
fi
rt=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
[ -S "$rt/bus" ] || exec "$@" </dev/null
scope() {
    systemd-run --user --scope --collect --quiet --slice=app-graphical.slice \
        --unit="app-${id:-app}-$$" -- "$@" </dev/null
}
# With --scope, systemd-run becomes the app once the scope exists, so its exit status cannot
# tell a refused scope (manager busy or restarting, no cgroup controller) from an app that
# failed. A marker the app's wrapper fills as the first thing it does in the scope can: empty
# after a failure means the app never ran, and it then starts plainly, as without a manager.
m="$rt/app-scope.$$"
{ true >"$m"; } 2>/dev/null || exec systemd-run --user --scope --collect --quiet \
    --slice=app-graphical.slice --unit="app-${id:-app}-$$" -- "$@" </dev/null
trap 'rm -f "$m"' EXIT
trap 'exit 1' HUP INT TERM
scope sh -c 'echo 1 >"$0" 2>/dev/null; exec "$@"' "$m" "$@"
rc=$?
[ -s "$m" ] && exit "$rc"
rm -f "$m"
exec "$@" </dev/null
